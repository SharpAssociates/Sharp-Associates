# ==============================================================================
# Sharp Associates - Server Configuration & Technical SEO (.htaccess)
# ==============================================================================

# 1. Directory Index & Options
DirectoryIndex index.php index.html
Options -Indexes

# 2. Rewrite Engine & Canonical Redirection
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect www to non-www (301 Permanent)
    RewriteCond %{HTTP_HOST} ^www\.sharpassociates\.in$ [NC]
    RewriteRule ^(.*)$ https://sharpassociates.in/$1 [R=301,L]

    # Redirect HTTP to HTTPS (Safe for Hostinger/Cloudflare/reverse proxies)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://sharpassociates.in/$1 [R=301,L]

    # Canonicalize /index.php to root / (avoid duplicate homepage)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php [NC]
    RewriteRule ^index\.php$ https://sharpassociates.in/ [R=301,L]

    # Block direct PHP execution inside uploads directory
    RewriteRule ^uploads/.*\.php$ - [F,L,NC]
</IfModule>

# 3. Security Hardening
# Block access to hidden files (.git, .env, .gitignore, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to sensitive source/executable files
<FilesMatch "\.(bat|log|sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Standard Safe Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Safe Caching Controls (Static assets cached, dynamic PHP pages never cached)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Dynamic pages: never cache via Expires
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/x-httpd-php "access plus 0 seconds"

    # Static assets caching
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Prevent caching of PHP pages to guarantee form & dynamic functionality
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Cache static resources
    <FilesMatch "\.(ico|jpg|jpeg|png|webp|svg|css|js|woff|woff2|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

